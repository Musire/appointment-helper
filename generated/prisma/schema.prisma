generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id
  email        String         @unique
  createdAt    DateTime       @default(now()) @map("created_at")
  fullName     String?        @map("full_name")
  avatarUrl    String?
  phone        String?
  authId       String?        @db.Uuid
  appointments Appointment[]  @relation("UserAppointments")
  invites      Invite[]
  notices      Notification[]
  staff        StaffProfile?
  stores       Store[]
  storeStaff   StoreStaff[]
  roles        UserRole[]
}

model Role {
  id    String     @id @default(uuid())
  name  RoleName   @unique
  users UserRole[]
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
}

model Store {
  id           String        @id @default(uuid())
  name         String        @unique
  address      String
  status       StoreStatus   @default(DRAFT)
  createdAt    DateTime      @default(now())
  createdById  String
  appointments Appointment[]
  invites      Invite[]
  services     Service[]
  createdBy    User          @relation(fields: [createdById], references: [id])
  config       StoreConfig?
  staff        StoreStaff[]
}

model StoreConfig {
  id        String      @id @default(uuid())
  storeId   String      @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  store     Store       @relation(fields: [storeId], references: [id])
  hours     StoreHour[]
}

model StoreHour {
  id            String      @id @default(uuid())
  storeConfigId String
  label         String
  isActive      Boolean
  start         String
  end           String
  storeConfig   StoreConfig @relation(fields: [storeConfigId], references: [id], onDelete: Cascade)
}

model StoreStaff {
  id           String              @id @default(uuid())
  storeId      String
  userId       String
  role         StoreRole
  status       StaffStatus
  appointments Appointment[]       @relation("StaffAppointments")
  availability StaffAvailability[]
  store        Store               @relation(fields: [storeId], references: [id])
  user         User                @relation(fields: [userId], references: [id])

  @@unique([storeId, userId])
}

model StaffProfile {
  id     String  @id @default(uuid())
  userId String  @unique
  bio    String?
  active Boolean @default(true)
  user   User    @relation(fields: [userId], references: [id])
}

model StaffAvailability {
  id           String     @id @default(uuid())
  startTime    Int
  endTime      Int
  storeStaffId String
  dayOfWeek    DayOfWeek
  storeStaff   StoreStaff @relation(fields: [storeStaffId], references: [id])

  @@index([storeStaffId, dayOfWeek])
}

model Service {
  id        String               @id @default(uuid())
  storeId   String
  name      String
  createdAt DateTime             @default(now())
  price     Int
  bookings  AppointmentService[]
  store     Store                @relation(fields: [storeId], references: [id])

  @@unique([storeId, name])
}

model Appointment {
  id          String               @id @default(uuid())
  storeId     String
  staffId     String
  userId      String
  startTime   DateTime
  endTime     DateTime
  status      AppointmentStatus
  createdAt   DateTime             @default(now())
  checkedInAt DateTime?
  staff       StoreStaff           @relation("StaffAppointments", fields: [staffId], references: [id])
  store       Store                @relation(fields: [storeId], references: [id])
  client      User                 @relation("UserAppointments", fields: [userId], references: [id])
  items       AppointmentService[]

  @@index([storeId, startTime])
  @@index([staffId, startTime])
}

model AppointmentService {
  id            String      @id @default(uuid())
  appointmentId String
  serviceId     String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  service       Service     @relation(fields: [serviceId], references: [id])

  @@unique([appointmentId, serviceId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  payload   Json
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId, read])
}

model Invite {
  id        String       @id @default(uuid())
  storeId   String
  role      StoreRole
  createdAt DateTime     @default(now())
  invitedBy String
  status    InviteStatus @default(PENDING)
  userId    String
  store     Store        @relation(fields: [storeId], references: [id])
  user      User         @relation(fields: [userId], references: [id])

  @@unique([storeId, userId])
  @@index([userId])
  @@index([storeId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  createdAt DateTime @default(now())

  @@index([actorId])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
}

enum RoleName {
  SUPERADMIN
  ADMIN
  STAFF
  USER
}

enum StoreRole {
  ADMIN
  STAFF
}

enum StoreStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

enum StaffStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum AppointmentStatus {
  PENDING
  CHECKIN
  INPROGRESS
  COMPLETED
  CANCELLED
  NOSHOW
}

enum NotificationType {
  APPOINTMENT_CREATED
  APPOINTMENT_UPDATED
  APPOINTMENT_CANCELLED
  STORE_INVITATION
}
